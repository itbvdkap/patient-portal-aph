NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
BOOKING_DATABASE_URL=
BOOKING_SUPABASE_URL=
BOOKING_SUPABASE_SERVICE_ROLE_KEY=
BOOKING_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORTAL_SESSION_SECRET=
ADMIN_PASSWORD=
# Internal single-node employee accounts (not Supabase/patient accounts). Disabled on public hosting.
ADMIN_STAFF_ENABLED=false
# Set to supabase only for the public admin deployment. Staff accounts and
# management drafts are encrypted before storage; Oracle/HIS is never contacted here.
ADMIN_DATA_MODE=file
ADMIN_CLOUD_STORE_SECRET=
# Absolute protected file path on internal server; never under public/ or a shared folder.
ADMIN_STAFF_STORE_PATH=
# Optional isolated draft/approval LAB. Synthetic data only; NEVER writes real HIS.
KSK_CHANGE_LAB_ENABLED=false
# Absolute protected path, outside public/. Separate from staff users and HIS files.
KSK_CHANGE_STORE_PATH=
# Real HIS management: independent permission/menu; drafts encrypted server-side.
KSK_MANAGEMENT_ENABLED=false
KSK_MANAGEMENT_BRANCH=CN1
KSK_MANAGEMENT_TOKEN=
KSK_MANAGEMENT_STORE_PATH=
# Optional independent secret (32+ chars). Empty derives draft key from PORTAL_SESSION_SECRET.
# Keep stable/backed up: changing it without migration makes old drafts unreadable.
KSK_MANAGEMENT_STORE_SECRET=
# Optional multi-role admin users. If set, ADMIN_PASSWORD fallback is ignored.
# Roles: super_admin, booking_admin, support, content_admin, auditor.
# ADMIN_USERS_JSON=[{"username":"admin","password":"change-me","role":"super_admin"},{"username":"booking","password":"change-me","role":"booking_admin"}]
PATIENT_API_BASE_URL=
PATIENT_API_SERVER_TOKEN=
# KSK read-only module. Use his for an internal web server or supabase for the
# public web deployment backed by the outbound-only hospital agent.
KSK_ENABLED=false
KSK_DATA_MODE=his
KSK_API_BASE_URL=http://127.0.0.1:5080
# Separate random secret, at least 32 characters; never NEXT_PUBLIC_.
KSK_API_SERVER_TOKEN=
AUTH_OTP_PROVIDER=test
AUTH_TEST_OTP=1234567
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
ZALO_ZNS_ENDPOINT=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_TOKEN_ENDPOINT=https://oauth.zaloapp.com/v4/oa/access_token
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_TEMPLATE_ID=
