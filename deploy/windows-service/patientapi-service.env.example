# Copy this file to patientapi-service.env on the Windows Server.
# Fill values on the server. Do not commit the real file.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080

PatientPortal__DataMode=OracleDirect
# Required on every server. Use CN1 on the CN1 HIS server and CN3 on the CN3 HIS server.
# Workers stop safely when this value is missing or invalid.
PatientPortal__BranchCode=CN1
PatientPortal__BranchName=Bệnh viện An Phú - Chi nhánh 1
PatientPortal__OracleMasterSchema=HGSOFT_BV
PatientPortal__OracleMonthlySchemaPrefix=HGSOFT_BV
PatientPortal__EnableSupabaseQueueAgent=true
PatientPortal__SupabaseQueueConcurrency=3
PatientPortal__EnableBookingHisMatchWorker=true
PatientPortal__BookingHisMatchIntervalSeconds=60
PatientPortal__BookingHisMatchBatchSize=25
PatientPortal__BookingHisMatchRetryMinutes=5
PatientPortal__EnableBookingHisOnlineSyncWorker=false
PatientPortal__BookingHisOnlineSyncIntervalSeconds=30
PatientPortal__BookingHisOnlineSyncBatchSize=25
PatientPortal__BookingHisOnlineSyncRetryMinutes=5
# Optional HIS defaults used when patient-entered text cannot be mapped to Oracle danh muc.
PatientPortal__HisOnlineDefaultProvinceCode=
PatientPortal__HisOnlineDefaultWardCode=
PatientPortal__HisOnlineDefaultOccupationCode=00000
PatientPortal__HisOnlineDefaultEthnicityCode=25
PatientPortal__HisOnlineDefaultDepartmentCode=
PatientPortal__HisOnlineDefaultDoctorCode=
PatientPortal__HisOnlineLegacySchemas=HGSOFT_BV,HGSOFT
PatientPortal__HisOnlineLegacyServiceCodes=
PatientPortal__EnableNotificationOutboxWorker=true
PatientPortal__NotificationOutboxAutoSendEnabled=false
PatientPortal__NotificationOutboxIntervalSeconds=30
PatientPortal__NotificationOutboxBatchSize=20
PatientPortal__NotificationOutboxRetryMinutes=5
PatientPortal__DisableHttpsRedirection=true

# Keep this equal to AUTH_SYNC_ENCRYPTION_KEY in Vercel.
AUTH_SYNC_ENCRYPTION_KEY=

# Supabase project URL and server-only secret/service key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase/Postgres booking database used by online appointment tables.
ConnectionStrings__BookingDatabase=

# Zalo ZNS for notification_outbox. Values can also be stored in portal_app_settings.
ZALO_ZNS_ENDPOINT=https://business.openapi.zalo.me/message/template
ZALO_TOKEN_ENDPOINT=https://oauth.zaloapp.com/v4/oa/access_token
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_BOOKING_CONFIRMED_TEMPLATE_ID=628108

# Oracle connection string. The online booking sync worker needs read HIS danh muc
# and insert/update HGSOFT_SOYBA.DANGKYKHAM.
ConnectionStrings__OracleHis=User Id=portal_readwrite;Password=change_me;Data Source=192.168.2.250:1521/hgsoft;

# Reduce noisy polling logs in production.
Logging__LogLevel__Default=Information
Logging__LogLevel__System=Warning
