NEXT_PUBLIC_DEMO_MODE=false
PATIENT_DATA_MODE=supabase

# Public browser config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true
BOOKING_DATABASE_URL=
BOOKING_SUPABASE_URL=
BOOKING_SUPABASE_SERVICE_ROLE_KEY=
BOOKING_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Set these in Vercel Environment Variables and never expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
PORTAL_SESSION_SECRET=
AUTH_SYNC_ENCRYPTION_KEY=
SUPABASE_AUTH_WAIT_MS=25000
SUPABASE_AUTH_POLL_INTERVAL_MS=1000
AUTH_OTP_PROVIDER=test
AUTH_TEST_OTP=1234567
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5

# Future Zalo/ZNS OTP provider. Set AUTH_OTP_PROVIDER=zalo when credentials and template are ready.
ZALO_ZNS_ENDPOINT=
ZALO_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=

# Kept for local OracleDirect/PatientApi development only. Do not set these in the public Vercel app.
PATIENT_API_BASE_URL=
PATIENT_API_SERVER_TOKEN=
